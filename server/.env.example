# OneClick SPLAT — Backend configuration
# Copy to .env and edit, or export these directly in your shell.

# Comma-separated list of allowed CORS origins.
# Default: http://localhost:3000,http://127.0.0.1:3000
OCS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-file upload cap in megabytes. Default: 4096 (4 GB).
OCS_MAX_UPLOAD_MB=4096

# Optional bearer token. When set, every request must include:
#   Authorization: Bearer <token>
# Leave empty to disable authentication entirely.
OCS_AUTH_TOKEN=

# Maximum number of /jobs creations per client IP per hour.
# Set to 0 to disable rate limiting. Default: 20.
OCS_RATE_LIMIT=20

# Minimum free disk space (in GB) on the jobs partition required to accept a new job.
# Default: 5.0
OCS_MIN_DISK_GB=5.0
